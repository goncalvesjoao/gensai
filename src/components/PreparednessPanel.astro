---
import { Card, CardHeader, CardContent } from './ui/card';
import CenterOnMe from './CenterOnMe';
---

<Card className="gap-0 rounded-2xl bg-white/90 py-0">
  <CardHeader className="border-b border-border bg-linear-to-br from-primary/8 to-primary/2 px-[18px] py-3.5">
    <h2 class="m-0 text-base font-bold text-[#0b5f5b]">Preparedness map</h2>
  </CardHeader>
  <CardContent className="p-[18px]">
    <p class="panel-copy">
      Use the map to check conditions near your current location.
    </p>
    <CenterOnMe client:load />
  </CardContent>
</Card>
