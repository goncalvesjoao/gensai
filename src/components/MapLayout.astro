---
import { Layers, X } from 'lucide-react';
import MapView from './MapView.jsx';
import AddressSearch from './AddressSearch.jsx';
import PreparednessPanel from './PreparednessPanel.astro';
const { locale = 'en' } = Astro.props;
const japanese = locale === 'ja';
const openLabel = japanese ? '災害メニューを開く' : 'Open hazard menu';
const closeLabel = japanese ? '災害メニューを閉じる' : 'Close hazard menu';
---

<main class="page-shell" data-sidebar-open="false">
  <div class="map-toolbar">
    <AddressSearch client:load locale={locale} />
  </div>
  <div class="content-grid">
    <aside
      class="sidebar"
      id="map-sidebar"
      inert
      hidden
      aria-label={japanese ? '防災マップ' : 'Preparedness map'}
    >
      <button
        class="map-control hazard-menu-close"
        type="button"
        data-sidebar-close
        aria-label={closeLabel}
      >
        <X size={20} aria-hidden="true" />
      </button>
      <PreparednessPanel locale={locale} />
    </aside>
    <section
      class="map-panel"
      aria-label={
        japanese ? '選択した場所の地図' : 'Map of your selected location'
      }
    >
      <MapView client:only="react" locale={locale} />
    </section>
  </div>
  <button
    class="map-control hazard-menu-open"
    type="button"
    data-sidebar-opener
    aria-controls="map-sidebar"
    aria-expanded="false"
    aria-label={openLabel}
  >
    <Layers size={20} aria-hidden="true" />
  </button>
</main>

<script is:inline>
  (() => {
    const shell = document.querySelector('.page-shell');
    const sidebar = document.getElementById('map-sidebar');
    const opener = shell.querySelector('[data-sidebar-opener]');
    const close = shell.querySelector('[data-sidebar-close]');
    function setOpen(open) {
      shell.dataset.sidebarOpen = String(open);
      sidebar.inert = !open;
      sidebar.hidden = !open;
      opener.setAttribute('aria-expanded', String(open));
    }
    function dismiss() {
      setOpen(false);
      opener.focus();
    }
    opener.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', dismiss);
    window.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === 'Escape' &&
          !event.defaultPrevented &&
          !document.querySelector('[role="menu"]') &&
          shell.dataset.sidebarOpen === 'true'
        ) {
          dismiss();
        }
      },
      true,
    );
  })();
</script>
