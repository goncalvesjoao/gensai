---
import '../styles/global.css';
import PreferenceControls from '../components/PreferenceControls.jsx';
import { localeFromPath } from '../lib/locale.mjs';
const locale = localeFromPath(Astro.url.pathname);
const { title = 'Gensai Map' } = Astro.props;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <!-- Apply preferences synchronously before the body can paint. -->
    <script is:inline>
      (() => {
        let theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        try {
          const savedTheme = localStorage.getItem('gensai-theme');
          if (savedTheme === 'light' || savedTheme === 'dark')
            theme = savedTheme;
        } catch {
          // Storage is optional; retain the system theme.
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <div class="fixed top-4 right-4 z-10">
      <PreferenceControls client:load locale={locale} />
    </div>
    <slot />
  </body>
</html>
