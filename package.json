{
  "name": "gensai",
  "version": "1.0.0",
  "description": "Gensai is a practical guide for disaster preparedness in Japan.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:fast && node scripts/test-browser.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:fast": "vitest run && npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "test:production": "node --test tests/browser/production-access.test.mjs",
    "test:live": "npm run build && node scripts/test-browser.mjs --live",
    "test:setup": "playwright install chromium",
    "test:react": "vitest run",
    "test:visual": "npm run build && node scripts/test-browser.mjs --visual",
    "test:all": "npm test && node scripts/test-browser.mjs --visual"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/goncalvesjoao/gensai"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.8.0",
    "astro": "^7.3.5",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-astro": {
      "astro-eslint-parser": "^2.1.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
